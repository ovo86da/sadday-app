# la comparación ruta/techo invertida
fichero: backend/src/main/java/com/sadday/app/mountains/service/NivelRutaService.java
busca: rank.apply(exigeRuta) > rank.apply(permiteNivel)
pon: rank.apply(exigeRuta) < rank.apply(permiteNivel)
test: ./mvnw -q -Dtest=NivelRutaServiceTest test

