# Credenciales para los tests end-to-end de Playwright.
#
#   cp frontend/.env.e2e.example frontend/.env.e2e
#
# `.env.e2e` está en .gitignore: nunca se commitea. Este ejemplo sí, para que
# quien clone el repo sepa qué variables hacen falta sin tener que leerse
# auth.setup.ts.
#
# En local valen los usuarios que siembra DevDataInitializer con el perfil
# `local` (ver sus contraseñas en el javadoc de ese fichero). En otro entorno,
# usar usuarios de prueba de ese entorno — nunca credenciales reales de nadie.

# Usuario con rol Admin: cubre lo que solo puede hacer la directiva.
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=

# Usuario con rol Socio, sin privilegios: cubre los límites de permisos.
E2E_SOCIO_USERNAME=socio
E2E_SOCIO_PASSWORD=

# Opcional. Por defecto http://localhost:5173
# E2E_BASE_URL=http://127.0.0.1:5173
