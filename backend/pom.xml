<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.sadday</groupId>
    <artifactId>sadday-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>sadday-app</name>
    <description>Sistema de gestión del Club de Montaña Sadday</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <!-- Subida de parche. Snyk la propone para cerrar
             SNYK-JAVA-IONETTY-20074868, pero por sí sola no lo hace: netty lo
             gestiona el BOM de Spring Boot, que manda sobre lo que declare el
             SDK (ver netty.version más abajo). Se sube igualmente para no
             fijar netty por encima de lo que el SDK espera. -->
        <aws-sdk.version>2.55.14</aws-sdk.version>
        <springdoc.version>3.1.1</springdoc.version>
        <bouncycastle.version>1.86</bouncycastle.version>

        <!-- ============================================================ -->
        <!-- Overrides del BOM de Spring Boot por CVEs                    -->
        <!-- Revisar en CADA subida de Spring Boot: si el parent ya trae  -->
        <!-- una versión igual o mayor, eliminar el override — dejarlo    -->
        <!-- puesto degradaría la dependencia.                            -->
        <!--                                                              -->
        <!-- netty: ya NO se fija. 4.0.8 gestiona 4.2.17.Final, superior  -->
        <!-- al 4.2.13 que necesitábamos; mantener el override la habría  -->
        <!-- bajado.                                                      -->
        <!-- ============================================================ -->
        <!-- 4.0.8 gestiona postgresql 42.7.13, que sigue afectada por
             CVE-2026-107314 (CWE-636 "Not Failing Securely", CVSS 8.2).
             Fix en 42.7.14, así que este override se mantiene. -->
        <postgresql.version>42.7.14</postgresql.version>
        <!-- Jackson: Spring Boot 4 gestiona DOS líneas a la vez, y las dos
             traían el mismo HIGH (Allocation of Resources Without Limits or
             Throttling) en 6 hallazgos entre ambas:

               jackson-2-bom  → com.fasterxml.jackson (2.x), que entra por
                                geoip2 y logstash-logback-encoder
               jackson-bom    → tools.jackson (3.x), que usa el propio
                                spring-boot-starter-jackson

             4.0.8 gestiona 2.21.5 y 3.1.5; los fixes están en 2.21.7 y 3.1.7,
             ambos a nivel de parche. Se suben las propiedades del BOM y no las
             librerías que los arrastran: Snyk sugiere subir
             logstash-logback-encoder de 8.0 a 9.0, pero eso NO arreglaría nada
             porque el BOM manda sobre lo que declare logstash — seguiríamos
             resolviendo la jackson gestionada. Revisar cuando el parent pase
             de estas dos. -->
        <!-- netty: el override se quitó al subir a Spring Boot 4.0.8, que
             gestionaba 4.2.17.Final y superaba el pin anterior de 4.2.13.
             Vuelve porque 4.2.17 trae SNYK-JAVA-IONETTY-20074868 (HIGH) en
             netty-codec-http, vía awssdk > netty-nio-client. Revisar cuando el
             parent pase de 4.2.19: si lo supera, este override degrada y hay
             que quitarlo otra vez. -->
        <netty.version>4.2.19.Final</netty.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>

        <!-- httpcomponents5: hoy no se usa, pero el AWS SDK ≥2.55 cambia de
             apache-client (httpclient 4.x) a apache5-client, y arrastra este
             árbol con las versiones que dicte el BOM del parent. Spring Boot
             4.0.8 gestiona httpclient5 5.5.2 y httpcore5 5.3.6, ambas con CVEs:

               CVE-2026-71290  httpclient5  validación incorrecta de certificado
                               CWE-295, CVSS 9.1 CRITICAL   → fix en 5.6.4
               CVE-2026-54428  httpcore5-h2 agotamiento de recursos
                               CWE-770, CVSS 7.1 HIGH       → fix en 5.4.3
               CVE-2026-54399  httpcore5-h2 ídem
                               CWE-770, CVSS 7.1 HIGH       → fix en 5.4.2

             Spring Boot 4.1.1 ya trae 5.6.4 y 5.4.3; al subir a esa versión
             estos dos overrides sobran y hay que quitarlos. -->
        <httpclient5.version>5.6.4</httpclient5.version>
        <httpcore5.version>5.4.3</httpcore5.version>

        <!-- Spring Boot 4.0.8 gestiona tomcat 11.0.24, con 3 CVEs CRITICAL
             que el gate de Trivy detecta en la imagen y bloquean el deploy:

               CVE-2026-65182 · CVE-2026-65905 · CVE-2026-68525   → fix en 11.0.25

             4.1.1 también gestiona 11.0.24, así que subir el parent NO
             resuelve esto: el override hace falta igualmente.

             Subido a 11.0.26 (2026-09-15) porque 11.0.25 arrastraba a su vez
             SNYK-JAVA-ORGAPACHETOMCATEMBED-20552494 (CRITICAL, Authentication
             Bypass by Alternate Name, en tomcat-embed-websocket) más el resto
             de la tanda que Tomcat lista como "Affects: 11.0.0-M1 to 11.0.25".
             Mismo patrón que pasó con postgresql 42.7.11: arreglar un CVE
             subiendo a una versión que ya tiene otro. Revisar cuando el parent
             pase de 11.0.26. -->
        <tomcat.version>11.0.26</tomcat.version>
        <!-- SonarCloud -->
        <sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.exclusions>**/dto/**,**/entity/**,**/config/**,**/shared/exception/**</sonar.exclusions>
        <sonar.coverage.exclusions>**/dto/**,**/entity/**,**/config/**,**/shared/exception/**</sonar.coverage.exclusions>
        <sonar.test.exclusions>**/test/**</sonar.test.exclusions>
    </properties>

    <dependencies>

        <!-- ============================================================ -->
        <!-- Spring Boot Starters                                         -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JWT: Encoding (JwtEncoder) + Decoding (JwtDecoder) con RS256 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ============================================================ -->
        <!-- Base de Datos                                                 -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Spring Boot 4.x: Flyway requiere su propio starter (no viene en autoconfigure) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ============================================================ -->
        <!-- Seguridad — Argon2 para hash de contraseñas                  -->
        <!-- Spring Security detecta BouncyCastle automáticamente         -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- Logging estructurado JSON (Logstash / Loki / CloudWatch)     -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- AWS SDK v2 — S3 para almacenamiento de PDFs                  -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${aws-sdk.version}</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- Generación de PDFs: HTML/CSS → PDF                          -->
        <!-- flying-saucer renderiza XHTML; OpenPDF genera el PDF         -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>org.xhtmlrenderer</groupId>
            <artifactId>flying-saucer-pdf-openpdf</artifactId>
            <version>9.4.0</version>
        </dependency>

        <!-- Thymeleaf standalone (sin integración Spring MVC) para templates PDF -->
        <dependency>
            <groupId>org.thymeleaf</groupId>
            <artifactId>thymeleaf</artifactId>
            <version>3.1.5.RELEASE</version>
        </dependency>

        <!-- CommonMark — conversión Markdown → XHTML para contenido de PDFs -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.30.0</version>
        </dependency>


        <!-- ============================================================ -->
        <!-- Generación de código                                          -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- Rate limiting — Bucket4j (in-memory, sin dependencias extra) -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>8.21.0</version>
        </dependency>

        <!-- Caffeine — caché in-memory con expiración automática         -->
        <!-- Usado por el rate limiter para evitar memory leaks por        -->
        <!-- acumulación ilimitada de buckets (SEC-02).                    -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- ============================================================ -->
        <!-- Geolocalización IP — MaxMind GeoLite2 (base de datos local) -->
        <!-- Requiere GeoLite2-City.mmdb descargado de maxmind.com y     -->
        <!-- configurado en sadday.geo.db-path                           -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>com.maxmind.geoip2</groupId>
            <artifactId>geoip2</artifactId>
            <version>5.2.0</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- Documentación OpenAPI / Swagger                              -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- Testing                                                       -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockMvc auto-configuration (movido a módulo propio en Spring Boot 4.x) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x — artifactIds renombrados -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot Testcontainers — @ServiceConnection para ligar el contenedor al contexto Spring -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <!-- Lombok debe ir ANTES que MapStruct -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- Surefire: fijar la zona para que los tests no dependan de la
                 zona de la máquina (el runner de CI va en UTC y los equipos de
                 desarrollo en Ecuador). El @{argLine} es obligatorio: preserva
                 el argLine que inyecta jacoco en prepare-agent; sobrescribirlo
                 dejaría la cobertura a cero. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Duser.timezone=America/Guayaquil</argLine>
                </configuration>
            </plugin>
            <!-- JaCoCo — cobertura de tests (requerido por SonarCloud) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <!-- Instrumenta el agente antes de los tests -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Genera el reporte XML/HTML en la fase verify -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Umbral mínimo de cobertura: build falla si baja del 60% de líneas -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <excludes>
                                        <exclude>**/dto/**</exclude>
                                        <exclude>**/entity/**</exclude>
                                        <exclude>**/config/**</exclude>
                                        <exclude>**/shared/exception/**</exclude>
                                    </excludes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.40</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Sonar Maven Plugin — análisis de calidad (invocado explícitamente en CI) -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>5.8.0.7211</version>
            </plugin>
        </plugins>
    </build>

</project>
